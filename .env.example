# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Runpod API key (console.runpod.io -> Settings -> API Keys). Required for the Runpod engine.
RUNPOD_API_KEY=

# Hugging Face token (huggingface.co/settings/tokens). Optional; faster model downloads.
HF_TOKEN=

# Optional: name for this machine's pod (default: h3-studio-<hostname>).
# H3_POD_NAME=

# Optional: port for the web UI (default 7833).
# H3_STUDIO_PORT=7833

# Optional: path to runpodctl if it isn't on PATH.
# RUNPODCTL=
